# ASR
ASR_ENGINE=funasr
FUNASR_MODEL=paraformer-zh
FUNASR_DEVICE=auto
FUNASR_LANGUAGE=auto
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_BATCH_SIZE_S=60
FUNASR_MERGE_LENGTH_S=15

# Whisper fallback
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=zh

# LLM
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Output
OUTPUT_DIR=./lecture_notes
